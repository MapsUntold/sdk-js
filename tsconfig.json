{
  "compilerOptions": {
    "module": "ESNext",                
    "target": "ES2019",                  
    "moduleResolution": "node",       
    "esModuleInterop": true,             
    "skipLibCheck": true,                
    "forceConsistentCasingInFileNames": true,  
    "strict": true,                     
    "outDir": "./dist",                 
    "declaration": true,                
    "declarationDir": "./dist/types",    
    "allowJs": true, 
    "importHelpers": true,
                    
  },
  "include": [
    "src/**/*"                            
  ],
  "exclude": [
    "node_modules"                        
  ]
}
